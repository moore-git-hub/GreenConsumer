      "student_t_confidence_intervals"
    ]
  },
  "api_contract": {
    "holm_adjust": {
      "input": "1-D finite p-values in [0,1]",
      "output": "same-length Holm-adjusted p-values in original order",
      "properties": [
        "monotone step-down adjustment",
        "clipped to [0,1]"
      ]
    },
    "wilson_interval": {
      "input": "successes, trials, confidence=0.95",
      "output": "two finite bounds in [0,1]"
    },
    "center_residual_matrix": {
      "input": "2-D finite matrix with rows=blocks, columns=estimands",
      "output": "same shape; each column mean zero within numerical tolerance"
    },
    "draw_synthetic_blocks": {
      "signature": "draw_synthetic_blocks(centered_residuals, n_blocks, stress_multiplier, rng_seed, truth_vector=None)",
      "rng": "numpy.random.Generator(numpy.random.PCG64(rng_seed))",
      "draw_order": [
        "row_indices = rng.integers(0, n_source_blocks, size=n_blocks)",
        "sign_bits = rng.integers(0, 2, size=n_blocks)",
        "signs = where(sign_bits==0, -1.0, +1.0)"
      ],
      "formula": "truth_vector + stress_multiplier * centered_residuals[row_indices] * signs[:,None]",
      "whole_block_required": true,
      "same_sign_for_all_28_coordinates_of_one_sampled_block": true
    },
    "one_sample_t_pvalues": {
      "test": "two-sided one-sample Student-t against null 0",
      "zero_variance_policy": "if all sample values equal 0 -> p=1; if zero variance with nonzero mean -> p=0"
    },
    "student_t_confidence_intervals": {
      "confidence": 0.95,
      "output": "lower and upper vectors by estimand"
    }
  },
  "fixture_acceptance": {
    "confirmatory_estimands": 28,
    "strategy_family_size": 16,
